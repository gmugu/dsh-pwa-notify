{
  "name": "dsh-pwa-notify",
  "version": "0.9.0",
  "description": "PWA install + real Web Push notifications for the DeepSeek Harness Web GUI: manifest + service worker + icons served by DSH itself (no gateway subprocess), VAPID/aes128gcm push (RFC 8291+8292 hand-rolled on node:crypto) that reaches the lock screen even after iOS kills the app, a live Settings card (per-kind toggles, custom notification text templates, test-send buttons), and a notify_user model tool.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "icons": "node scripts/gen-icons.mjs",
    "install:profile": "node scripts/install-to-profile.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-modules": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-jobs": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-workspace": "^0.1.7-alpha.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "pwa",
    "progressive-web-app",
    "notifications",
    "service-worker",
    "mobile",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "pwa",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmugu/dsh-pwa-notify.git"
  },
  "homepage": "https://github.com/gmugu/dsh-pwa-notify#readme",
  "bugs": {
    "url": "https://github.com/gmugu/dsh-pwa-notify/issues"
  }
}
