{
  "name": "dsh-pwa-notify",
  "version": "0.2.0",
  "description": "PWA install + real Web Push notifications for the DeepSeek Harness Web GUI: manifest + service worker + icons served by DSH itself (no gateway subprocess), VAPID/aes128gcm push (RFC 8291+8292 hand-rolled on node:crypto, zero npm deps) that reaches the lock screen even after iOS kills the app, a poll fallback channel, and a notify_user model tool.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "icons": "node scripts/gen-icons.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "pwa",
    "progressive-web-app",
    "notifications",
    "service-worker",
    "mobile",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "pwa",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ]
}
